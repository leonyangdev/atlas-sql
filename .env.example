# Copy to .env.atlas for local development. Never use these example passwords in production.
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO
ATLAS_CONTROL_DATABASE_URL=postgresql://atlas_control:atlas_control_dev@127.0.0.1:5432/atlas_control
ATLAS_BUSINESS_DATABASE_URL=postgresql://atlas_reader:atlas_reader_dev@127.0.0.1:5433/nova_retail
ATLAS_REDIS_URL=redis://127.0.0.1:6379/0
ATLAS_OPENSEARCH_URL=http://127.0.0.1:9200
ATLAS_MILVUS_HOST=127.0.0.1
ATLAS_MILVUS_PORT=19530
ATLAS_DEPENDENCY_TIMEOUT_SECONDS=2

ATLAS_CONTROL_DB_NAME=atlas_control
ATLAS_CONTROL_DB_USER=atlas_control
ATLAS_CONTROL_DB_PASSWORD=atlas_control_dev
ATLAS_BUSINESS_DB_NAME=nova_retail
ATLAS_BUSINESS_DB_OWNER=atlas_owner
ATLAS_BUSINESS_DB_OWNER_PASSWORD=atlas_owner_dev
ATLAS_BUSINESS_DB_READER=atlas_reader
ATLAS_BUSINESS_DB_READER_PASSWORD=atlas_reader_dev

