{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve: backend",
      "type": "shell",
      "command": "uv run uvicorn server.api.app:create_app --factory --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "label": "Backend API :8000",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "serve: web",
      "type": "shell",
      "command": "npm run dev --workspace @atlas-sql/web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "label": "Web :3000",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs-web",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Next\\.js",
          "endsPattern": "Ready in"
        }
      }
    },
    {
      "label": "serve: admin",
      "type": "shell",
      "command": "npm run dev --workspace @atlas-sql/admin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "label": "Admin :3001",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs-admin",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Next\\.js",
          "endsPattern": "Ready in"
        }
      }
    },
    {
      "label": "serve: book",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/altassql-book"
      },
      "presentation": {
        "label": "Book :5173",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vitepress",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vitepress v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Start: All Services",
      "dependsOn": [
        "serve: backend",
        "serve: web",
        "serve: admin",
        "serve: book"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
